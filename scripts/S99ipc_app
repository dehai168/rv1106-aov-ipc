#!/bin/sh
# Luckfox init.d script for ipc_app (T5.2).
# Install: scripts/install_init.sh (requires root on board).

DAEMON=/userdata/ipc_app
WATCHDOG=/userdata/ipc_watchdog.sh
LOG=/userdata/log/ipc_app.log
export LD_LIBRARY_PATH=/oem/usr/lib:/oem/lib:${LD_LIBRARY_PATH:-}

wait_sdcard() {
  i=0
  while [ "$i" -lt 30 ]; do
    if mountpoint -q /mnt/sdcard 2>/dev/null || [ -d /mnt/sdcard/records ]; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

# Never call RkLunch-stop.sh here — it loops forever if rkipc ignores SIGTERM.
stop_oem_camera() {
  killall rk_mpi_ao_test 2>/dev/null || true
  killall rkipc 2>/dev/null || true
  sleep 1
  killall -9 rkipc rk_mpi_ao_test 2>/dev/null || true
  rm -f /tmp/aiq0.lock 2>/dev/null || true
}

# OEM nginx (+fcgiwrap) holds :80 with the stock rkipc web UI. ipc_app serves
# its own UI on :80, so park the OEM rc scripts outside RkLunch's S??* glob
# (undo: mv them back from $OEM_INITD/disabled/) and stop the running daemons.
OEM_INITD=/oem/usr/etc/init.d
stop_oem_web() {
  for s in S50nginx S50fcgiwrap; do
    if [ -f "$OEM_INITD/$s" ]; then
      mkdir -p "$OEM_INITD/disabled" && mv -f "$OEM_INITD/$s" "$OEM_INITD/disabled/$s"
    fi
  done
  killall nginx fcgiwrap 2>/dev/null || true
  sleep 1
  killall -9 nginx fcgiwrap 2>/dev/null || true
}

# RkLunch.sh post_chk launches rkipc at every boot; killing it later (above,
# and in the watchdog) leaks rockit CMA buffers, which then starves our
# preview-main encoder. Comment the launch out once (backup: RkLunch.sh.orig).
RKLUNCH=/oem/usr/bin/RkLunch.sh
disable_oem_rkipc() {
  if grep -qE '^[[:space:]]*rkipc( |&|$)' "$RKLUNCH" 2>/dev/null; then
    [ -f "$RKLUNCH.orig" ] || cp -f "$RKLUNCH" "$RKLUNCH.orig"
    sed -i -E 's/^([[:space:]]*)(rkipc( .*)?&)$/\1: # disabled by ipc_app: \2/' "$RKLUNCH"
  fi
}

start() {
  disable_oem_rkipc
  stop_oem_web
  stop_oem_camera
  mkdir -p /userdata/log /var/run
  if pidof ipc_app >/dev/null 2>&1; then
    echo "ipc_app already running"
    return 0
  fi
  wait_sdcard || echo "WARN: sdcard not ready, starting anyway"
  if [ -x "$WATCHDOG" ]; then
    nohup "$WATCHDOG" >/dev/null 2>&1 &
  elif [ -x "$DAEMON" ]; then
    nohup "$DAEMON" --web >/dev/null 2>&1 &
  else
    echo "missing $DAEMON"
    return 1
  fi
  # Catch late RkLunch post_chk that starts rkipc after we return.
  (sleep 8; stop_oem_camera) >/dev/null 2>&1 &
  (sleep 20; stop_oem_camera) >/dev/null 2>&1 &
  echo "ipc_app started"
}

stop() {
  killall ipc_app 2>/dev/null || true
  for p in $(pidof sh 2>/dev/null); do
    if tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q ipc_watchdog; then
      kill "$p" 2>/dev/null || true
    fi
  done
  echo "ipc_app stopped"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
